# Sidelook does not load .env and accepts no model API credentials.
# It uses gpt-6-astra through the installed Codex CLI's ChatGPT login, or a local model that LM Studio or Ollama serve on this computer.
# Subscription authentication is required for the OpenAI and Anthropic models. There is no API fallback.
# SIDELOOK_DESKTOP_KEY is generated in memory by the Windows launcher, never configured here.

# --- Agent mode (docs/AGENT_MODE_IMPLEMENTATION.md section 17) ---
# Agent mode is the only Sidelook surface that reads .env, through lib/agent/config.mjs. Copy this file to .env and fill in real
# values; .env stays out of git. Every value below is a placeholder — never commit a real key, token or secret.

# DashClaw governs every consequential write. Two keys, two roles, on purpose: the AGENT key records actions and can never approve
# them (DashClaw refuses self-approval), so a compromised or malfunctioning agent cannot rubber-stamp its own refund or email. The
# APPROVER key belongs to the human who clicks Approve/Reject and needs the admin role to submit that decision. Create both at
# /api-keys on your DashClaw instance: one member-role key, one admin-role key. Never use the same key for both.
DASHCLAW_BASE_URL=http://localhost:3000
# The agent's own key, member role. Records actions, polls status, claims executions. Must NOT hold the admin role.
DASHCLAW_API_KEY=oc_live_fakeagentkey0000000000000
# The approver's key, admin role. Only used to submit the person's Approve/Reject decision. Defaults to DASHCLAW_API_KEY if unset,
# which disables approval (DashClaw's self-approval refusal then blocks every hold) — set a real admin key to approve anything.
DASHCLAW_APPROVER_API_KEY=oc_live_fakeapproverkey000000000
# The agent id every governed action and policy row is scoped to. Matches the id used when the agent key was created.
DASHCLAW_AGENT_ID=sidelook-agent

# Slack: where the agent reads the customer's cancellation/refund request. Bot token needs channels:history, channels:read, users:read.
SLACK_BOT_TOKEN=xoxb-fake-slack-bot-token-000000
# Comma-separated channel ids or names the agent is allowed to search. No default: an empty list means Slack reads find nothing.
SLACK_CHANNELS=support-requests
# How many days back a Slack search looks for the customer's request.
SLACK_LOOKBACK_DAYS=30
# Optional: the channel scripts/agent-seed.mjs posts the demo cancellation request into. Needs chat:write on the bot token.
SLACK_SEED_CHANNEL=

# Stripe: TEST MODE by default (sk_test_ / rk_test_ keys only). A live key (sk_live_/rk_live_) makes every write throw CONFIG
# and refuse to run unless STRIPE_ALLOW_LIVE=1 is set on purpose — leave it unset for the hackathon and every demo.
STRIPE_SECRET_KEY=sk_test_fake000000000000000000000000
# Optional: a test-mode key that wins over STRIPE_SECRET_KEY whenever it is set, so a machine that also holds a live key stays in test mode.
STRIPE_TEST_SECRET_KEY=
# Refuses live-mode writes even with a live key. Set to exactly 1, deliberately, to allow real Stripe writes. Leave unset otherwise.
STRIPE_ALLOW_LIVE=
# Ceiling on one refund, in cents. A refund above this (or any live-mode refund) carries risk_score 100 and DashClaw blocks it.
AGENT_REFUND_MAX_CENTS=100000

# HubSpot: private app token with crm.objects.contacts.read and crm.objects.contacts.write.
HUBSPOT_ACCESS_TOKEN=pat-fake-000000000000000000000000
# The contact property the agent updates (must already exist on the HubSpot portal).
HUBSPOT_STATUS_PROPERTY=hs_lead_status
# The value the agent writes into that property.
HUBSPOT_STATUS_VALUE=UNQUALIFIED
# Comma-separated values the agent is allowed to write; a value outside this list is refused. Defaults to HUBSPOT_STATUS_VALUE alone.
HUBSPOT_ALLOWED_VALUES=UNQUALIFIED

# Gmail: OAuth refresh-token flow. Create a Google Cloud OAuth desktop client, then run `npm run agent:gmail-auth` to fill the
# refresh token below — never type a real Google secret directly into this file by hand outside that flow.
GMAIL_CLIENT_ID=000000000000-fake.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-fake0000000000000000000000
# Printed once by `npm run agent:gmail-auth`; paste it here. Grants gmail.send and gmail.readonly, nothing else.
GMAIL_REFRESH_TOKEN=1//fake-refresh-token-000000000000
# The address Sidelook sends from; must be the Google account that completed the OAuth consent.
GMAIL_FROM=agent@example.com

# Seed script only: the demo customer/domain the fixtures and seed data use across Slack, Stripe, HubSpot and Gmail.
AGENT_DEMO_CUSTOMER=Acme
AGENT_DEMO_DOMAIN=acme.com
# The demo customer's address in Stripe, HubSpot and the Slack request. Demo A really emails it, so use an inbox you
# control (a plus alias of GMAIL_FROM works). Empty means demo-<domain slug>@<domain>.
AGENT_DEMO_EMAIL=
# Demo C's customer (Globex, one $5,000.00 payment over the refund ceiling, so DashClaw blocks the refund). Its address
# defaults to a +globex alias of AGENT_DEMO_EMAIL, or demo-globex-com@globex.com when that is empty; nothing is ever sent to it.
AGENT_DEMO_BLOCK_EMAIL=

# Demo B: makes the first HubSpot write in every run fail once, on purpose, to show the recovery sweep on the timeline.
HACKATHON_FAIL_HUBSPOT_ONCE=
# Set to 1 to let tests/agent-live.test.mjs call the real Slack/Stripe/HubSpot/Gmail/DashClaw services. Off by default; CI never sets it.
RUN_LIVE_AGENT_TESTS=

# Overrides where run JSON files are written. Leave unset to use the default per-OS Sidelook data directory.
SIDELOOK_AGENT_DATA=
