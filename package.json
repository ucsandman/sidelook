{
  "name": "sidelook",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/check.mjs",
    "build": "node scripts/check.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:vision": "node scripts/verify-vision.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "build:site": "node scripts/build-site.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "build:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "verify:windows": "node scripts/verify-windows.mjs",
    "verify:stream": "node scripts/verify-stream.mjs",
    "verify:computer": "node scripts/verify-computer.mjs",
    "verify:computer-native": "node scripts/verify-computer-native.mjs",
    "verify:assistant": "node scripts/verify-assistant.mjs",
    "verify:companion": "node scripts/verify-companion.mjs",
    "verify:states": "node scripts/verify-states.mjs",
    "verify:mark": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-mark.ps1"
  },
  "license": "MIT",
  "dependencies": {
    "dashclaw": "5.33.9"
  }
}
