{
  "name": "sidelook",
  "version": "0.18.0",
  "description": "A desktop companion for Windows that runs on the ChatGPT or Claude subscription you already pay for, or on a local model in LM Studio or Ollama.",
  "repository": { "type": "git", "url": "https://github.com/ucsandman/sidelook.git" },
  "homepage": "https://sidelook.practicalsystems.io",
  "bugs": "https://github.com/ucsandman/sidelook/issues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/check.mjs",
    "build": "node scripts/check.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:vision": "node scripts/verify-vision.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "build:site": "node scripts/build-site.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "build:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "verify:windows": "node scripts/verify-windows.mjs",
    "verify:stream": "node scripts/verify-stream.mjs",
    "verify:computer": "node scripts/verify-computer.mjs",
    "verify:computer-native": "node scripts/verify-computer-native.mjs",
    "verify:assistant": "node scripts/verify-assistant.mjs",
    "verify:companion": "node scripts/verify-companion.mjs",
    "verify:states": "node scripts/verify-states.mjs",
    "verify:mark": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-mark.ps1",
    "eval:agent": "node eval/run.mjs",
    "verify:agent": "node scripts/verify-agent.mjs",
    "agent:health": "node scripts/agent-health.mjs",
    "agent:seed": "node scripts/agent-seed.mjs",
    "agent:setup-dashclaw": "node scripts/agent-setup-dashclaw.mjs",
    "agent:gmail-auth": "node scripts/gmail-auth.mjs --open",
    "test:agent-live": "node --test tests/agent-live.test.mjs",
    "agent:learn": "node agent-learning/learn.mjs",
    "agent:regress": "node agent-learning/regress.mjs --set all",
    "verify:learn": "node agent-learning/learn.mjs --fixtures agent-learning/fixtures --out .artifacts/agent-learning/verify --max-candidates 3 --verify",
    "agent:learn:nightly": "node agent-learning/nightly.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "dashclaw": "5.33.9"
  }
}
